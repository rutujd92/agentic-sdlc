{
  "allowedPaths": [
    "src/UrlShortener.*/**",
    "tests/UrlShortener.Tests/**",
    "docs/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "approvalPaths": [
    "**/Migrations/**",
    "**/*.csproj",
    "docker-compose.yml"
  ],
  "blockedPaths": [
    ".github/**",
    "policies.json",
    "**/*.pem",
    "**/*.pfx",
    "**/.env"
  ],
  "secretPatterns": [
    "(?i)password\\s*=\\s*[^;\\s\"]{4,}",
    "(?i)(api[_-]?key|secret)\\s*[:=]\\s*\"[^\"]{8,}\"",
    "AKIA[0-9A-Z]{16}",
    "sk-ant-[A-Za-z0-9_-]{20,}",
    "ghp_[A-Za-z0-9]{36}",
    "-----BEGIN [A-Z ]*PRIVATE KEY-----"
  ],
  "allowedLicenses": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "PostgreSQL"],
  "packageLicenses": {
    "QRCoder": "MIT",
    "Microsoft.EntityFrameworkCore": "MIT",
    "Npgsql.EntityFrameworkCore.PostgreSQL": "PostgreSQL",
    "Testcontainers.PostgreSql": "MIT",
    "SomeGplLibrary": "GPL-3.0"
  }
}
